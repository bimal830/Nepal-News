rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /news/{newsId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'published'
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 180
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 500;
      allow update: if isAdmin()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 180;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
      match /bookmarks/{newsId} {
        allow read, create, delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
    }
  }
}